<Window x:Class="ANDBIM.Revit.DS.Services.ANDBIMProgressBarWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ANDBIM.Revit.DS.Services"
             mc:Ignorable="d" 
             Height="50" Width="350"
             Title="Процесс создания файлов"
             WindowStartupLocation="CenterScreen"
             WindowStyle="None"
             Background="Transparent"
             AllowsTransparency="True"
             MouseLeftButtonDown="Grid_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ANDBIM.Revit.DS;component/Services/ANDBIMWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="20"
                      CaptionHeight="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="10"/>
    </WindowChrome.WindowChrome>
    <Grid>
        
        <Border Background="WhiteSmoke"
                CornerRadius="12"
                Grid.RowSpan="2"
                BorderThickness="1"
                BorderBrush="Black"/>
        <Grid Margin="10">
            <ProgressBar x:Name="Progress"
                         Grid.Row="1"
                         Margin="1"
                         Minimum="0"
                         BorderBrush="Transparent"
                         Background="WhiteSmoke">
                <ProgressBar.Foreground>
                    <LinearGradientBrush EndPoint="0,0" StartPoint="1,1">
                        <GradientStop Color="#a0cee3" Offset="0"/>
                        <GradientStop Color="#eeb799" Offset="1"/>
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
            </ProgressBar>
            <TextBlock x:Name="FileName"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
        
            
    </Grid>
</Window>
