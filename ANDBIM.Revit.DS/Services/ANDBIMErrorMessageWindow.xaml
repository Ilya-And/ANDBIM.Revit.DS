<Window x:Class="ANDBIM.Revit.DS.Services.ANDBIMErrorMessageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ANDBIM.Revit.DS.Services"
             mc:Ignorable="d" 
             Height="300" Width="500">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ANDBIM.Revit.DS;component/Services/ANDBIMWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="5">
        <TextBox x:Name="MessageText"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Left"
                 TextWrapping="Wrap"
                 Style="{StaticResource ANDBIMTextBoxStyle}"
                 IsReadOnly="True"/>

    </Grid>
</Window>
