<Window x:Class="ANDBIM.Revit.DS.Services.ANDBIMErrorMessageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ANDBIM.Revit.DS.Services"
             mc:Ignorable="d" 
             WindowStyle="None"
             Background="Transparent"
             AllowsTransparency="True"
             MouseLeftButtonDown="Grid_MouseLeftButtonDown"
             WindowStartupLocation="CenterScreen"
             SizeToContent="WidthAndHeight"
             Height="200" Width="300">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ANDBIM.Revit.DS;component/Services/ANDBIMWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="7"
                      CaptionHeight="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="10"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Background="White"
                CornerRadius="7"
                Grid.RowSpan="2"
                BorderThickness="1"
                BorderBrush="Black"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Border Background="WhiteSmoke"
                    CornerRadius="7,7,0,0"
                    BorderThickness="1"
                    BorderBrush="Black" Grid.ColumnSpan="3"/>
            <Button Grid.Column="2"
                    Content="⨉"
                    Style="{StaticResource ANDBIMCloseButtonStyle}"
                    Margin="5"
                    Click="CloseButtonClick"
                    VerticalContentAlignment="Center"/>
            <!--<Image Source="pack://application:,,,/ANDBIM.Revit.DS;component/Resources/ANDBIM_LOGO.ico"
       Margin="7"/>-->
            <TextBlock x:Name="WindowName"
                       Grid.Column="1"
                       Text="Ошибка"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="MessageText"
                     Margin="5"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Left"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     IsReadOnly="True"/>
            <Button Grid.Row="1"
                    Style="{StaticResource ANDBIMButtonStyle}"
                    Content="OK"
                    Click="Button_Click"/>
        </Grid>

    </Grid>
</Window>
