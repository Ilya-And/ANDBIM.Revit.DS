<Window x:Class="ANDBIM.Revit.DS.SetButtonParametersWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ANDBIM.Revit.DS"
             mc:Ignorable="d" 
             SizeToContent="Height"
             Height="300" Width="400">
    <Grid>
        <StackPanel>
            <TextBlock Text="Введите имя"/>
            <TextBox Text="{Binding ButtonName}"/>

            <TextBlock Text="Выберите изображение"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ImagePath}"
                         IsEnabled="False"/>
                <Button Command="{Binding GetImageCommand}"
                        Content="..."
                        Grid.Column="1"/>
            </Grid>

            <TextBlock Text="Выберите панель"/>
            <ComboBox ItemsSource="{Binding Panels}"
                      SelectedItem="{Binding SelectedPanel}"/>

            <TextBlock Text="Выберите скрипт"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ScriptPath}"/>
                <Button Command="{Binding GetScriptCommand}"
                        Content="..."
                        Grid.Column="1"/>
            </Grid>

            <TextBlock Text="Введите описание"/>
            <TextBox Text="{Binding Description}"/>

            <TextBlock Text="Введите дополнительное описание"/>
            <TextBox Text="{Binding LongDescription}"/>

            <Button Content="Создать"
                    Command="{Binding StartCommand}"/>
        </StackPanel>
    </Grid>
</Window>
